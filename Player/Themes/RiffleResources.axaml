<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Add Resources Here -->
    <SolidColorBrush x:Key="ForegroundDefault">Black</SolidColorBrush>
    <SolidColorBrush x:Key="ForegroundPlaying">Green</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonInactive">DimGray</SolidColorBrush>
    <SolidColorBrush x:Key="ButtonActive">White</SolidColorBrush>
</ResourceDictionary>
