<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Player.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Player.Desktop.Converters"
        xmlns:models="clr-namespace:Riffle.Core.Models;assembly=Core"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Player.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Height="600"
        Width="900"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        MinWidth="600"
        MinHeight="500"
        Title="Riffle Music Player"
        >

    <!--<Design.DataContext>
        ~1~ This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) @1@
        <vm:DesignerMainWindowViewModel/>
    </Design.DataContext>-->

    <Window.Resources>
        <converters:ReferenceEqualityConverter x:Key="ReferenceEqualityConverter"/>
        <converters:IndexToNumberConverter x:Key="IndexToNumberConverter"/>
        <!--<converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>-->
    </Window.Resources>

    <!--<WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            CornerRadius="20"
            GlassFrameThickness="5"
            ResizeBorderThickness="5"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>-->

    <Grid
        ClipToBounds="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> 
            <RowDefinition Height="*"/>    
            <RowDefinition Height="Auto"/> 
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Background="#222" PointerPressed="Border_PointerPressed" Height="35">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal">
                <TextBlock
                    Text="RifflePlayer"
                    Foreground="White"
                    FontSize="20"
                    Margin="25,5,30,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center" />
            </StackPanel>

            <!-- Window Controls -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Grid.Column="1">
                <!-- Minimize -->
                <Button Width="25"
                        Height="25"
                        Content="—"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Foreground="White"
                        Margin="2"
                        Click="Minimize_Click" />

                <!-- Maximize / Restore -->
                <Button Width="25"
                        Height="25"
                        Content="⬜"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        Foreground="White"
                        FontSize="5"
                        Margin="2"
                        Click="Maximize_Click" />

                <!-- Close -->
                <Button Width="25"
                        Height="25"
                        Content="✕"
                        Margin="2,2,4,2"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        FontSize="10"
                        Click="Close_Click"
                        Foreground="Red" />
            </StackPanel>
        </Grid>

        <!-- Main layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Playlists -->
            <StackPanel Grid.Column="0">
                <StackPanel
                    Orientation="Horizontal"
                    Margin="10,2,10,5">
                    <TextBlock Margin="30,0,5,0" FontSize="24">Playlists</TextBlock>
                    <Button 
                        Margin="2,0"
                        Click="AddPlaylist_Click"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Width="25"
                        Height="25"
                        FontSize="15"
                        Background="Gray"
                        Foreground="White"
                        Padding="-2,-3.3, -2 , -0.5"
                        Content="+"/>
                    <Button 
                        Margin="2,0"
                        Click="RemovePlaylist_Click"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Width="25"
                        Height="25"
                        FontSize="15"
                        Padding="-2,-3.3, -2 , -0.5"
                        Background="Gray"
                        Foreground="White">
                        -
                    </Button>
                </StackPanel>
                <ListBox x:Name="PlaylistList"
                         ItemsSource="{Binding SidebarViewModel.Playlists}"
                         SelectedItem="{Binding SelectedPlaylist, Mode=TwoWay}"
                         SelectionChanged="PlaylistList_OnSelected"
                         DoubleTapped="PlaylistList_OnMouseDoubleClick"
                         SizeChanged="PlaylistList_OnSizeChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.Tag>
                                <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).CurrentPlaylistPlaying"/>
                                </MultiBinding>
                            </Border.Tag>
                            <Border BorderBrush="Black" BorderThickness="1" 
                                    CornerRadius="4" Padding="4">
                                <TextBlock Text="{Binding Playlist.Name}"/>
                            </Border>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem">
        
                        <!-- DEFAULT STYLE -->
                        <Style Selector="^">
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundDefault}"/>
                        </Style>

                        <!-- PLAYING STYLE -->
                        <Style Selector="^[Tag=true]">
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundPlaying}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>

                    </ControlTheme>
                </ListBox.ItemContainerTheme>

                <!--<ListBox.View>
                    <GridView x:Name="PlaylistView">
                        <GridViewColumn Width="200" DisplayMemberBinding="{Binding Name}">
                            <GridViewColumn.Header>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                                    <TextBlock Text="Playlists" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Button Content="+" Width="20" Height="20" Margin="0,0,2,0"
                                            Click="AddPlaylist_Click"/>
                                    <Button Content="−" Width="20" Height="20"
                                            Click="RemovePlaylist_Click"/>
                                </StackPanel>
                            </GridViewColumn.Header>
                        </GridViewColumn>
                    </GridView>
                </ListBox.View>-->
                </ListBox>
            </StackPanel>
                

            <!-- Songs -->
            
            <ScrollViewer 
                VerticalScrollBarVisibility="Auto"
                Grid.Column="1">
                <StackPanel>
                    <!-- Playlist Header -->
                    <Border Background="#222" Padding="10,5" Margin="0,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPlaylist.Name}" 
                                       FontSize="56" FontWeight="Bold" Foreground="White"/>
                            <TextBlock
                                x:Name="PlaylistInfo"
                                Text="0 songs, 0 hr 0 min"
                                FontSize="14" Foreground="LightGray"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <!--<StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">-->
                                <StackPanel
                                    Grid.Column="0"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left">
                                    <!--<Button 
                                        x:Name="PlaylistPlayBtn"
                                        Content="⏸" 
                                        Padding="-2,-2,-2,-0.5"
                                        FontSize="18"
                                        Margin="0,0,10,0"
                                        Command="{Binding PlayPlaylistCommand}" 
                                        Width="Auto" 
                                        Click="PlaylistPlayBtn_OnBtnClick"
                                    /> -->
                                    <Button 
                                        x:Name="PlaylistPlayBtn"
                                        Content="▶" 
                                        Padding="5,-1,5,0"
                                        FontSize="12"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Width="25"
                                        Height="25"
                                        Margin="0,0,5,0"
                                        Background="LightGray"
                                        Click="PlaylistPlayBtn_OnBtnClick"
                                    />
                                        <!--Command="{Binding PlayPlaylistCommand}"--> 
                                    <Button
                                        x:Name="BtnShuffleHeader"
                                        Content="🔀" 
                                        FontSize="18"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Width="25"
                                        Height="25"
                                        Margin="5,0"
                                        Background="LightGray"
                                        Foreground="Black"
                                        Padding="-2,-3.3, -2 , -0.5" />
                                    <Button
                                        x:Name="BtnImportSong"
                                        Click="BtnImportSong_OnClick"
                                        FontWeight="Bold"
                                        FontSize="22"
                                        Content="+"
                                        Background="LightGray"
                                        Foreground="Black"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Margin="5,0"
                                        Height="25"
                                        Width="25"
                                        Padding="-2,-3.3, -2 , -0.5"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    Orientation="Horizontal" 
                                    HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBox x:Name="SearchBox"
                                                 Width="200"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,8,0"
                                                 Padding="2"
                                                 Watermark="Search..."
                                                 FontSize="12">
                                            <TextBox.Styles>
                                                <!-- Default -->
                                                <Style Selector="TextBox">
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                </Style>

                                                <!-- When user typed -->
                                                <Style Selector="TextBox:not(:empty)">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Style>
                                            </TextBox.Styles>
                                            <!--<TextBox.Style Selector="TextBox">
                                                <Setter Property="Foreground" Value="Gray"/>
                                                <Setter Property="Text" Value="Search..."/>
                                                <Style Selector="TextBox:focus">
                                                    <Setter Property="Foreground" Value="Black"/>
                                                    <Setter Property="Text" Value=""/>
                                                </Style>
                                            </TextBox.Style>-->
                                        </TextBox>
                                        <!--<ComboBox ItemsSource="{Binding SortOptions}" 
                                                  SelectedItem="{Binding SelectedSortOption}" Margin="10,0,0,0"/>-->
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Playlist Songs -->
                    <ListBox x:Name="PlaylistContent"
                          ItemsSource="{Binding SongsViewModel.PlaylistSongs}"
                          DoubleTapped="PlaylistContent_OnMouseDoubleClick"
                          SizeChanged="PlaylistContent_OnSizeChanged"
                          BorderThickness="0"
                          Padding="10,0"
                          >
                          <!--Height = "Auto"-->

                        <!--<ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <d:Style.DataContext>
                                    <models:PlaylistSong />
                                </d:Style.DataContext>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}">
                                                <Binding Path=".Song.Id" /> ~1~ Song in this row @1@
                                                <Binding Path="ViewModel.CurrentSong.Song.Id" RelativeSource="{RelativeSource AncestorType=Window}" />
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Foreground" Value="Green"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>-->
                        <!--<ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                                <Setter Property="Content" >
                                    <Setter.Value>
                                        <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}">
                                            <Binding Path="."/>
                                            <Binding Path="$parent[Window].DataContext.CurrentSong"/>
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>-->

                        <!--<ListBox.View>
                            <GridView x:Name="GridView">
                                ~1~ Number Column: Left-aligned @1@
                                <GridViewColumn Header="#" Width="20">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock 
                                                Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, 
                                                Path=(ItemsControl.AlternationIndex), Converter={StaticResource IndexToNumberConverter}}"
                                                HorizontalAlignment="Left"
                                                TextAlignment="Left"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                ~1~ Title Column: Left-aligned @1@
                                <GridViewColumn Header="Title" Width="200">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock 
                                                Text="{Binding Song.Title}"
                                                HorizontalAlignment="Left"
                                                TextAlignment="Left"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                ~1~ Artist Column: Center-aligned @1@
                                <GridViewColumn Header="Artist" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock 
                                                Text="{Binding Song.Artist}"
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                ~1~ Date Added Column: Center-aligned @1@
                                <GridViewColumn Header="Date added" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock 
                                                Text="{Binding HowLongAgo}"
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                ~1~ Duration Column: Center-aligned @1@
                                <GridViewColumn Header="Duration" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock 
                                                Text="{Binding Song.DurationDisplay}"
                                                HorizontalAlignment="Center"
                                                TextAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListBox.View>-->
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="PlaylistItems" ColumnDefinitions="30,200,100,150,100">

                                    <Grid.Tag>
                                        <MultiBinding Converter="{StaticResource ReferenceEqualityConverter}">
                                            <Binding Path="."/>
                                            <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).CurrentSong"/>
                                        </MultiBinding>
                                    </Grid.Tag>
                                    
                                    <Grid.Styles>

                                        <!-- Default -->
                                        <Style Selector="Grid TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundDefault}"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                        </Style>

                                        <!-- Playing -->
                                        <Style Selector="Grid[Tag=true] TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ForegroundPlaying}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>

                                    </Grid.Styles>
                                    
                                    <!-- Index -->
                                    <TextBlock Grid.Column="0"
                                               HorizontalAlignment="Left">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource IndexToNumberConverter}">
                                                <!-- current item -->
                                                <Binding Path="."/>
            
                                                <!-- full list -->
                                                <Binding Path="$parent[ListBox].ItemsSource"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!-- Title -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Song.Title}"
                                               HorizontalAlignment="Left"/>

                                    <!-- Artist -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Song.Artist}"
                                               HorizontalAlignment="Left"/>

                                    <!-- Date -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding HowLongAgo}"
                                               HorizontalAlignment="Center"/>

                                    <!-- Duration -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Song.DurationDisplay}"
                                               HorizontalAlignment="Center"/>

                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </StackPanel>
            </ScrollViewer>
            
            <StackPanel
                x:Name="QueueWindowGridSpace"
                Width="200"
                Grid.Column="2"
                IsVisible="{Binding IsQueueWindowOpen}">
            </StackPanel>
        </Grid>

        <!--<Border Background="White"
                BorderBrush="Gray" BorderThickness="1"
                x:Name="QueueOverlay" 
                HorizontalAlignment="Right"
                Grid.Row="1"
                IsVisible="{Binding IsQueueWindowOpen}">
            <TabControl Width="200" Margin="2">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                         <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> ~1~ Tab headers @1@
                                <RowDefinition Height="*"/>    ~1~ Tab content @1@
                            </Grid.RowDefinitions>
                            
                            ~1~ Header panel with custom content @1@
                            <Grid VerticalAlignment="Top" Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />    ~1~ Tabs @1@
                                    <ColumnDefinition Width="Auto" /> ~1~ Close button @1@
                                </Grid.ColumnDefinitions>

                                ~1~ Tab headers @1@
                                <TabPanel x:Name="HeaderPanel"
                                          Grid.Column="0"
                                          IsItemsHost="True"
                                          Background="{TemplateBinding Background}" />

                                ~1~ Close button @1@
                                <Button Grid.Column="1"
                                        Content="✕"
                                        Width="20"
                                        Height="20"
                                        Click="Queue_OnClick"
                                        Background="Transparent"
                                        BorderThickness="0,0,0,0"
                                        FontSize="12"
                                        Foreground="Gray"
                                        Margin="5,0,5,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                            </Grid>

                            ~1~ Content @1@
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="0" 
                                              Grid.Row="1"/>
                         </Grid>
                    </ControlTemplate>
                </TabControl.Template>-->
        <Border Background="White"
                BorderBrush="Gray"
                BorderThickness="1"
                x:Name="QueueOverlay"
                HorizontalAlignment="Right"
                Grid.Row="1"
                IsVisible="{Binding IsQueueWindowOpen}">

            <TabControl Width="200" Margin="2">

                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- HEADER -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ItemsPresenter x:Name="HeaderPanel"
                                          Grid.Column="0"
                                          />
                                          <!--IsItemsHost="True"-->

                                <Button Grid.Column="1"
                                        Content="✕"
                                        Width="20"
                                        Height="20"
                                        Click="Queue_OnClick"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="Gray"
                                        Margin="5,0"/>
                            </Grid>

                            <!-- CONTENT -->
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              Content="{TemplateBinding SelectedContent}"/>
                        </Grid>

                    </ControlTemplate>
                </TabControl.Template>
                
                <TabItem Header="Queue">
                    <Grid Margin="5,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Now Playing -->
                            <RowDefinition Height="Auto"/> <!-- User Queue -->
                            <RowDefinition Height="*"/>    <!-- Playlist Source: stretches fully -->
                        </Grid.RowDefinitions>
                        <StackPanel
                            Grid.Row="0"> <!-- Now playing -->
                            <StackPanel
                                Orientation="Horizontal"
                                >
                                <TextBlock FontSize="12" Foreground="Black"
                                           Text="Now playing from: "
                                           Padding="0,10,10,0"/>
                                <Button 
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="Transparent"
                                        Foreground="Black"
                                        BorderThickness="0"
                                        Click="GoToCurrentSongPlaylist">
                                    <!--Width="Auto"-->
                                    <Run Text="{Binding (vm:MainWindowViewModel).CurrentSongPlaylistName, 
                                                          Mode=OneWay,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </Button>
                                
                            </StackPanel>
                            <TextBlock Text="{Binding (vm:MainWindowViewModel).CurrentSongTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="12" Foreground="Black"
                                       Padding="10,0,0,0"/>
                            <TextBlock Text="{Binding (vm:MainWindowViewModel).CurrentSongArtist, RelativeSource={RelativeSource AncestorType=Window}}"
                                       FontSize="12" Foreground="Black"
                                       Padding="10,0,0,0"/>
                        </StackPanel>
                        <Border
                            Grid.Row="1"
                            Background="White"
                            x:Name="UserQueueOverlay" 
                            IsVisible="{Binding IsQueueVisible}"> <!-- User queue -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Tab headers -->
                                    <RowDefinition Height="*"/>    <!-- Tab content -->
                                </Grid.RowDefinitions>
                                    <Grid
                                        Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/> <!-- Tab headers -->
                                            <ColumnDefinition Width="*"/>    <!-- Tab content -->
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Queue" 
                                                   FontSize="12" Foreground="Black"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Bottom"/>
                                        <Button
                                            Grid.Column="1"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Content="Clear queue"
                                            Background="Transparent"
                                            Foreground="DimGray"
                                            BorderThickness="0"
                                            Click="ClearQueueClick"/>
                                            <!--Width="Auto"-->
                                </Grid>
                                <!-- TODO <ListBox 
                                    Grid.Row="1"
                                    x:Name="UserQueueList"
                                >
                                </ListBox>-->
                            </Grid>
                        </Border>
                        <Border
                            Grid.Row="2"
                            x:Name="PlaylistSourceOverlay"
                            IsVisible="{Binding IsCurrentPlayingPlaylistQueueVisible}"> <!-- Playlist Source -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Tab headers -->
                                    <RowDefinition Height="*"/>    <!-- Tab content -->
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" 
                                    Grid.Row="0">
                                    <TextBlock
                                        Padding="0,10,10,0"
                                        FontSize="12" Foreground="Black" 
                                        Text="Next from: "/>
                                    <Button
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="Transparent"
                                        Foreground="Black"
                                        BorderThickness="0"
                                        Click="GoToCurrentPlaylistPlaying">
                                        <Run Text="{Binding (vm:MainWindowViewModel).CurrentPlaylistName, 
                                                          Mode=OneWay,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    </Button>
                                        <!--Width="Auto"-->
                                </StackPanel>
                                <!--<ListBox
                                    Grid.Row="1"
                                    x:Name="QueueListBox"
                                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"> 
                                    <ListBox.Resources>
                                        <Style Selector="GridViewColumnHeader">
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                            <Setter Property="Height" Value="0"></Setter>
                                        </Style>
                                    </ListBox.Resources>
                                    <ListBox.ItemContainerTheme>
                                        <ControlTheme TargetType="ListBoxItem">
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ControlTheme>
                                    </ListBox.ItemContainerTheme>
                                    <ListBox.View>
                                        <GridView>
                                            <GridViewColumn
                                                x:Name="QueueOverlayColumn">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical"
                                                                    d:DataContext="{d:DesignInstance models:PlaylistSong, IsDesignTimeCreatable=False}">
                                                            <TextBlock Text="{Binding Song.Title}" FontWeight="Bold" />
                                                            <TextBlock Text="{Binding Song.Artist}" FontStyle="Italic" FontSize="12" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListBox.View>
                                </ListBox>-->
                                <ListBox Grid.Row="1"
                                         x:Name="QueueListView"
                                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                                    <ListBox.ItemContainerTheme>
                                        <ControlTheme TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </ControlTheme>
                                    </ListBox.ItemContainerTheme>

                                    <ListBox.ItemTemplate>
                                        <DataTemplate>

                                            <Grid ColumnDefinitions="*,Auto"
                                                  >
                                                  <!-- TODO Padding="4"-->

                                                <!-- Title + Artist -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding (models:PlaylistSong).Song.Title}"
                                                               FontWeight="Bold"/>

                                                    <TextBlock Text="{Binding (models:PlaylistSong).Song.Artist}"
                                                               FontStyle="Italic"
                                                               FontSize="12"/>
                                                </StackPanel>

                                            </Grid>

                                        </DataTemplate>
                                    </ListBox.ItemTemplate>

                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Recently Played">
                    <!--<ListBox 
                        x:Name="RecentlyPlayedListBox"
                        ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        BorderThickness="0"
                        >
                        <ListBox.Resources>
                            <Style TargetType="GridViewColumnHeader">
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Height" Value="0"></Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.View>
                            <GridView>
                                <GridViewColumn>
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Vertical"
                                                        d:DataContext="{d:DesignInstance models:SongPlayed, IsDesignTimeCreatable=False}">
                                                <TextBlock Text="{Binding Song.Title}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Song.Artist}" FontStyle="Italic" FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListBox.View>
                    </ListBox>-->
                    <ListBox x:Name="RecentlyPlayedListView"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             BorderThickness="0">

                        <ListBox.ItemTemplate>
                            <DataTemplate>

                                <Grid>

                                    <StackPanel>
                                        <TextBlock Text="{Binding (models:PlaylistSong).Song.Title}"
                                                   FontWeight="Bold"/>

                                        <TextBlock Text="{Binding (models:PlaylistSong).Song.Artist}"
                                                   FontStyle="Italic"
                                                   FontSize="12"/>
                                    </StackPanel>

                                </Grid>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                </TabItem>
            </TabControl>
        </Border>

        <!-- Control bar -->
        <Grid Grid.Row="2" Background="#222">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/> 
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/> 
            </Grid.ColumnDefinitions>
            <!-- Left: Song title + artist -->
            <StackPanel 
                Grid.Column="0"
                Margin="10" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Left"
                >
                <TextBlock x:Name="TxtSongTitle" Text="Song Title" FontWeight="Bold" FontSize="14" Foreground="White"/>
                <TextBlock x:Name="TxtArtistName" Text="Artist Name" FontSize="12" Foreground="White"/>
            </StackPanel>

            <!-- Middle: controls (nested grid for top + bottom rows) -->
            <Grid
                Grid.Column="1"
                Margin="10"
                HorizontalAlignment="Stretch"
            >
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- buttons row -->
                    <RowDefinition Height="Auto"/> <!-- seekbar row -->
                </Grid.RowDefinitions>

                <!-- Buttons row -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button
                        x:Name="BtnShuffle"
                        Content="🔀" 
                        FontSize="20"
                        HorizontalContentAlignment="Center"
                        Width="24"
                        Height="24"
                        Padding="-2.5,-3.5, -2, -0.5"
                        Margin="5,5"
                        />
                    <Button
                        x:Name="BtnPreviousSong"
                        Content="⏮" 
                        FontSize="20"
                        HorizontalContentAlignment="Center"
                        Width="24"
                        Height="24"
                        Padding="-2.5,-3.5, -2, -0.5"
                        Margin="5,5"
                        Click="BtnPreviousSong_OnClick" />
                    <Button
                        x:Name="BtnPauseResume"
                        Content="▶" 
                        FontSize="16"
                        Padding="2,-2, 2, -0.5"
                        HorizontalContentAlignment="Center"
                        Width="24"
                        Height="24"
                        Margin="5,5"
                        Click="OnPauseResume" />
                    <Button
                        x:Name="BtnNextSong"
                        Content="⏭" 
                        FontSize="20"
                        HorizontalContentAlignment="Center"
                        Width="24"
                        Height="24"
                        Padding="-2.5,-3.5, -2, -0.5"
                        Margin="5,5"
                        Click="BtnNextSong_OnClick" />
                    <Button
                        x:Name="BtnLoop"
                        Content="🔁" 
                        FontSize="20"
                        HorizontalContentAlignment="Center"
                        Width="24"
                        Height="24"
                        Padding="-2.5,-3.5, -2, -0.5"
                        Margin="5,5"
                        Click="BtnLoop_OnClick"
                        Background="White" />
                </StackPanel>

                <!-- Seekbar row with times -->
                <Grid Grid.Row="1" Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="TxtCurrentTime"
                        Text="0:00"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Margin="5"
                        Foreground="White" />
                    <Slider
                        x:Name="SeekBar"
                        Grid.Column="1"
                        Minimum="0"
                        Maximum="100"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Margin="5"
                        PointerCaptureLost="SeekBar_PointerReleased"
                        ValueChanged="SeekBar_ValueChanged">
                        <!--IsMoveToPointEnabled="False"-->
                        <!--PointerMoved="SeekBar_PointerMoved"
                        PointerPressed="SeekBar_PointerPressed"
                        Holding="SeekBar_Holding"
-->
                    </Slider>
                    <TextBlock
                        x:Name="TxtTotalTime"
                        Text="3:45"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Margin="5"
                        Foreground="White" />
                </Grid>
            </Grid>

            <!-- Right: Queue + volume -->
            <Grid
                Grid.Column="2"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock
                    x:Name="TxtVolumePercentage"
                    Grid.Column="1"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Text="100%"
                    Foreground="White"
                    />
                <Button 
                    Content="Q" 
                    Margin="0,5" 
                    Grid.Column="0"
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Click="Queue_OnClick" />
                <Slider
                    x:Name="VolumeBar"
                    Minimum="0"
                    Maximum="100"
                    Value="100"
                    HorizontalAlignment="Stretch"
                    MinWidth="10"
                    MaxWidth="200"
                    VerticalAlignment="Center"
                    Margin="0"
                    Grid.Column="1"
                    Grid.Row="1"
                    ValueChanged="VolumeBar_ValueChanged" />
                    <!--IsMoveToPointEnabled="True"-->
            </Grid>
        </Grid>

    </Grid>
</Window>
