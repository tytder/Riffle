<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Player.Desktop.App"
             xmlns:local="using:Player.Desktop"
             xmlns:controls="clr-namespace:Player.Controls;assembly=Player"
             RequestedThemeVariant="Light">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
             
     <Application.Styles>
         <FluentTheme />
         
         
     </Application.Styles>
             
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Player/Themes/ScrollableTabControl.axaml"/>
                <ResourceInclude Source="avares://Player/Themes/RiffleResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        
        <!--

        _buttonInactiveBrush = new SolidColorBrush(buttonInactiveColor);
        _buttonActiveBrush = new SolidColorBrush(Colors.White);
-->
    </Application.Resources>
</Application>